@model OMRAutoFillApp.Models.ViewModels.OMRFillViewModel

@{
    ViewData["Title"] = "OMR Auto-Fill System";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="bi bi-pencil-square"></i> OMR Auto-Fill System</h3>
                </div>
                <div class="card-body">
                    <form asp-action="FillOMR" method="post" enctype="multipart/form-data" id="omrForm">
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> Upload your OMR template and configuration, then fill in the required information to generate a filled OMR sheet.
                        </div>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger" role="alert">
                                <div asp-validation-summary="All" class="text-danger"></div>
                            </div>
                        }

                        <!-- Template Image Upload -->
                        <div class="mb-3">
                            <label asp-for="TemplateImage" class="form-label fw-bold">
                                <i class="bi bi-file-earmark-image"></i> Upload OMR Template Image *
                            </label>
                            <input asp-for="TemplateImage" type="file" class="form-control" accept=".png,.jpg,.jpeg" required />
                            <span asp-validation-for="TemplateImage" class="text-danger"></span>
                            <div class="form-text">Upload your blank OMR template (PNG or JPG format)</div>
                        </div>

                        <!-- Template Configuration Upload -->
                        <div class="mb-3">
                            <label asp-for="TemplateConfiguration" class="form-label fw-bold">
                                <i class="bi bi-file-earmark-code"></i> Upload Template Configuration *
                            </label>
                            <input asp-for="TemplateConfiguration" type="file" class="form-control" accept=".json" required />
                            <span asp-validation-for="TemplateConfiguration" class="text-danger"></span>
                            <div class="form-text">Upload the JSON configuration file with bubble coordinates</div>
                        </div>

                        <!-- Roll Number -->
                        <div class="mb-3">
                            <label asp-for="RollNumber" class="form-label fw-bold">
                                <i class="bi bi-123"></i> Roll Number *
                            </label>
                            <input asp-for="RollNumber" class="form-control" placeholder="Enter roll number (digits only)" required />
                            <span asp-validation-for="RollNumber" class="text-danger"></span>
                            <div class="form-text">Enter your roll number (digits only, as per template configuration)</div>
                        </div>

                        <!-- Registration Number -->
                        <div class="mb-3">
                            <label asp-for="RegistrationNumber" class="form-label fw-bold">
                                <i class="bi bi-card-text"></i> Registration Number *
                            </label>
                            <input asp-for="RegistrationNumber" class="form-control" placeholder="Enter registration number (digits only)" required />
                            <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
                            <div class="form-text">Enter your registration number (digits only, as per template configuration)</div>
                        </div>

                        <!-- MCQ Answers -->
                        <div class="mb-3">
                            <label asp-for="McqAnswers" class="form-label fw-bold">
                                <i class="bi bi-list-check"></i> MCQ Answers (Optional)
                            </label>
                            <textarea asp-for="McqAnswers" class="form-control" rows="3" placeholder="Enter answers separated by commas (e.g., A,B,C,D,A,B...)"></textarea>
                            <span asp-validation-for="McqAnswers" class="text-danger"></span>
                            <div class="form-text">For MCQ templates only. Leave blank for SAQ templates.</div>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-download"></i> Generate & Download Filled OMR
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Instructions -->
            <div class="card mt-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="bi bi-question-circle"></i> Instructions</h5>
                </div>
                <div class="card-body">
                    <ol>
                        <li><strong>Prepare Your Template:</strong> Have your blank OMR template image ready (PNG or JPG format)</li>
                        <li><strong>Prepare Configuration:</strong> Create a JSON configuration file with bubble coordinates for your template (see format below)</li>
                        <li><strong>Upload Files:</strong> Upload both the template image and configuration file</li>
                        <li><strong>Enter Information:</strong> Fill in your roll number and registration number</li>
                        <li><strong>Enter MCQ Answers:</strong> For MCQ templates, enter your answers separated by commas (e.g., A,B,C,D...)</li>
                        <li><strong>Generate OMR:</strong> Click "Generate & Download Filled OMR" to create your filled sheet</li>
                    </ol>

                    <h6 class="mt-3">Configuration File Format:</h6>
                    <pre class="bg-light p-3 rounded"><code>{
  "templateId": "YOUR_TEMPLATE_ID",
  "templateType": "MCQ",  // or "SAQ"
  "dpi": 300,
  "roll": {
    "digits": 6,
    "columns": [
      {"0": [100,100], "1": [100,120], "2": [100,140], ...}
    ]
  },
  "reg": {
    "digits": 8,
    "columns": [...]
  },
  "mcq": {  // For MCQ templates only
    "questionCount": 10,
    "options": ["A","B","C","D"],
    "coordinates": {
      "1": {"A": [120,520], "B": [145,520], ...}
    }
  }
}</code></pre>
                    <p class="mt-2">
                        <a href="https://github.com/MehediRumon/OMR-Auto-Fill-Web-Application/tree/main/Templates" target="_blank" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-github"></i> View Sample Templates & Configurations
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
